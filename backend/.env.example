# Server port
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# JWT signing secret — use a strong random value in production
JWT_SECRET=super_secret_jwt_key

# Comma-separated list of allowed CORS origins
# Examples:
#   Local:       http://localhost:5173
#   LAN:         http://192.168.1.100:5173
#   Cloudflare:  https://abc123.trycloudflare.com
#   Production:  https://collabdocs.com
CORS_ORIGIN=http://localhost:5173

# Frontend URL used by the backend for generating links
# Must match one of the CORS_ORIGIN entries
FRONTEND_URL=http://localhost:5173

# Node environment (development | test | production)
# Defaults to 'development' if omitted
# NODE_ENV=development
