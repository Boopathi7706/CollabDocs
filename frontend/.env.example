# Backend API URL — the ONLY networking configuration needed for the frontend.
# All API calls and WebSocket connections derive from this single value.
#
# Local Development:   VITE_API_URL=http://localhost:3001
# LAN Testing:         VITE_API_URL=http://192.168.1.100:3001
# Cloudflare Tunnel:   VITE_API_URL=https://your-tunnel.trycloudflare.com
# Railway:             VITE_API_URL=https://collabdocs-api.up.railway.app
# Render:              VITE_API_URL=https://collabdocs-api.onrender.com
# Production:          VITE_API_URL=https://api.collabdocs.com
VITE_API_URL=http://localhost:3001
